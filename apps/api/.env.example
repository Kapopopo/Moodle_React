DATABASE_URL=postgresql://moodly:moodly_local@localhost:5432/moodly
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
PORT=3001
CORS_ORIGINS=http://localhost:5173,http://192.168.1.10:5173,http://localhost,https://localhost,capacitor://localhost
MIN_RESPONSES=3

# Separate from JWT_SECRET. Generate using: openssl rand -hex 32
# Keep this key stable and backed up to decrypt existing VSS reports.
VSS_ENCRYPTION_KEY=

# Account creation only (npm run vss:setup). Never share these credentials.
MOODLY_ADMIN_EMAIL=
MOODLY_ADMIN_PASSWORD=
