{
  "name": "moodly",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w apps/api\" \"npm run dev -w apps/mobile\"",
    "build": "npm run build --workspaces",
    "test": "npm test -w apps/api",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "db:seed": "npm run db:seed -w apps/api",
    "test:ui": "playwright test",
    "test:db": "TEST_DATABASE=1 npm test -w apps/api",
    "vss:setup": "npm run vss:setup -w apps/api"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "concurrently": "^9.1.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
